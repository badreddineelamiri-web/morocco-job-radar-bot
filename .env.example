# AI Provider Configuration
AI_PROVIDER=auto
AI_FINAL_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_SUMMARY_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_TRANSLATION_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_REWRITE_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_SEO_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_HTML_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_TASK_FACEBOOK_PROVIDER_ORDER=gemini,groq,mistral,nvidia,huggingface,together,openrouter,cohere,openai
AI_MAX_MODELS_PER_PROVIDER=0

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-pro-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-3-27b-it:free,liquid/lfm-2.5-1.2b-instruct:free

# Cohere
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025
COHERE_MODELS=command-a-03-2025,command-r-plus-08-2024,command-r-08-2024

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen3.6-35B-A3B
HUGGINGFACE_MODELS=Qwen/Qwen3.6-35B-A3B,Qwen/Qwen3.5-35B-A3B,meta-llama/Llama-3.3-70B-Instruct,openai/gpt-oss-120b,google/gemma-3-27b-it

# Mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODELS=mistral-small-latest,ministral-14b-latest,magistral-small-latest,open-mistral-nemo

# NVIDIA
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1.5,nvidia/llama-3.1-nemotron-51b-instruct

# Together
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=Qwen/Qwen3.5-397B-A17B
TOGETHER_MODELS=Qwen/Qwen3.5-397B-A17B,moonshotai/Kimi-K2.5,openai/gpt-oss-120b,Qwen/Qwen3.5-35B-A3B,meta-llama/Llama-3.3-70B-Instruct-Turbo

# Facebook Page Configuration
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Optional: Dry run mode (set to "true" for testing without actual publishing)
# DRY_RUN=true
